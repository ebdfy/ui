{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The playground's fake API and reports, its Admin pages and the site's routes are for the dev servers and the Worker, not for apps.
  "exclude": ["src/playground-api.ts", "src/playground-admin.ts", "src/playground-reports.ts", "src/site-routes.ts"]
}
