{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The playground's fake API is for the dev servers and the Worker, not for apps.
  "exclude": ["src/playground-api.ts"]
}
